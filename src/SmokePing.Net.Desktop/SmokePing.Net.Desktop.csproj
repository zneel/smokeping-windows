<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmokePing.Net.Desktop</RootNamespace>
    <AssemblyName>SmokePing.Net.Desktop</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Lets the project build on a non-Windows machine (CI, or a Linux workstation). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Referenced explicitly rather than through UseWindowsForms, because some
      distributions ship a .NET SDK without the WindowsDesktop SDK targets and the
      implicit route then fails to build at all.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SmokePing.Net/SmokePing.Net.csproj" />
  </ItemGroup>

</Project>
